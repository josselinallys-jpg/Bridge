<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Bridge.Desktop</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bridge.Core\Bridge.Core.csproj" />
    <ProjectReference Include="..\Bridge.AI.Bidding\Bridge.AI.Bidding.csproj" />
    <ProjectReference Include="..\Bridge.AI.CardPlay\Bridge.AI.CardPlay.csproj" />
    <ProjectReference Include="..\Bridge.Engine\Bridge.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\*.png" />
    <None Update="Rules\auction-tooltip-rules.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\bidding-profile.json" Link="bidding-profile.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\sef-bidding-profile.json" Link="sef-bidding-profile.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
